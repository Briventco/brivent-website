PORT=3002
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
FIREBASE_PROJECT_ID=brivent-website
ADMIN_EMAILS=admin@example.com

# Firebase Storage bucket the admin dashboard uploads images to.
# Defaults to "<FIREBASE_PROJECT_ID>.appspot.com" if not set.
# FIREBASE_STORAGE_BUCKET=brivent-website.appspot.com

# Note: the values below are the Firebase web client config you sent.
# They are useful in the frontend, but the backend still needs a server-side
# credential (service account JSON/file or application default credentials)
# to write to Firestore through firebase-admin.

# Choose one Firebase auth method:
# 1) Local service account file
# FIREBASE_SERVICE_ACCOUNT_PATH=C:/absolute/path/to/serviceAccountKey.json
#
# 2) Inline service account JSON
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"..."}
#
# 3) Explicit credentials
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#
# Optional for local Firestore emulator
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
